{
  "name": "dsh-429-auto-continue",
  "version": "1.1.0",
  "description": "DSH plugin: when a turn dies from HTTP 429 / rate-limit / quota exhaustion, wait a configurable delay and automatically send a continue message to the same session so the task resumes by itself. (429 兜底插件：回合因 429/限流/配额耗尽失败后，自动发送「继续任务」让任务接着跑。)",
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "429",
    "rate-limit",
    "quota",
    "continue",
    "auto-continue",
    "resume"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "license": "MIT"
}
